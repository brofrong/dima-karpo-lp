{
  "name": "dima-karpo-lp",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "preview": "bunx --bun astro preview",
    "test": "bun test",
    "lint": "bun lint --no-script src scripts astro.config.mjs",
    "fmt": "bun fmt --no-script src scripts docs astro.config.mjs README.md",
    "fmt:check": "bun fmt --no-script --check src scripts docs astro.config.mjs README.md",
    "typecheck": "bunx --bun astro check",
    "verify": "bun test && bun run lint && bun run fmt:check && bun run typecheck && bun run build",
    "shot": "bun scripts/shot.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.10",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/bun": "^1.4.4",
    "@types/three": "^0.187.0",
    "puppeteer-core": "^25.17.0",
    "typescript": "^6"
  }
}
