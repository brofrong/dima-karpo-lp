---
import { Image } from "astro:assets";
import { site, helloLink } from "../../data/site";
import { photos } from "../../data/photos";
---

<header class="relative w-full min-h-screen bg-[#0a0e27] flex items-center overflow-hidden">
  <!-- 3D WebGL Canvas -->
  <canvas
    data-hero-canvas
    class="absolute inset-0 w-full h-full pointer-events-none"
    width="1440"
    height="900">
  </canvas>

  <!-- Keeps the copy readable on top of the moving canvas -->
  <div
    class="absolute inset-0 pointer-events-none bg-gradient-to-r from-[#0a0e27] via-[#0a0e27]/70 to-transparent"
    aria-hidden="true"
  >
  </div>

  <div
    class="relative z-10 w-full max-w-7xl mx-auto px-6 md:px-12 lg:px-16 py-20 lg:py-24 grid grid-cols-1 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] gap-12 lg:gap-16 items-center"
  >
    <!-- Copy -->
    <div class="text-center lg:text-left" data-section>
      <p class="hero-kicker font-display text-xs md:text-sm uppercase text-[#ffd60a] mb-5">
        Постановка свадебного танца
      </p>

      <h1 class="font-display font-bold text-4xl md:text-6xl lg:text-7xl leading-[1.05] mb-6 neon-text">
        Ваша свадьба<br />в движении
      </h1>

      <p class="text-lg md:text-xl text-[#00d9ff] mb-10 max-w-xl mx-auto lg:mx-0">
        Поставлю ваш первый танец так, чтобы его запомнили навсегда
      </p>

      <div class="flex flex-col sm:flex-row gap-4 justify-center lg:justify-start items-center mb-10">
        <a href={helloLink} target="_blank" rel="noopener noreferrer" class="btn-neon no-underline">
          Написать в Telegram
        </a>
        <a href="#planner" class="btn-neon-secondary no-underline">
          Посчитать занятия
        </a>
      </div>

      <p class="max-w-xl mx-auto lg:mx-0 text-sm md:text-base text-gray-300">
        Я {site.firstName} — преподаватель бачаты и постановщик свадебных танцев. Ставлю бачату и любой
        другой свадебный танец под вашу музыку, даже если вы никогда не танцевали.
      </p>
    </div>

    <!-- Photo -->
    <div class="hero-photo relative w-full max-w-sm mx-auto lg:max-w-md lg:mr-0" data-reveal>
      <div class="hero-photo-glow" aria-hidden="true"></div>
      <div class="relative neon-border overflow-hidden">
        <Image
          src={photos.danceSmile.src}
          alt={photos.danceSmile.alt}
          widths={[320, 640]}
          sizes="(max-width: 1024px) 384px, 448px"
          loading="eager"
          class="block w-full aspect-[4/5] object-cover"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-[#0a0e27]/70 via-transparent to-transparent pointer-events-none"
        >
        </div>
      </div>
      <span class="hero-photo-tag font-display">бачата</span>
    </div>
  </div>
</header>

<style>
  .hero-kicker {
    letter-spacing: 0.3em;
  }

  .hero-photo {
    transform: rotate(2deg);
  }

  .hero-photo-glow {
    position: absolute;
    inset: -12%;
    background: radial-gradient(
      circle at 50% 50%,
      rgba(255, 0, 110, 0.35),
      rgba(0, 217, 255, 0.12) 45%,
      transparent 70%
    );
    filter: blur(24px);
    pointer-events: none;
  }

  .hero-photo-tag {
    position: absolute;
    left: -0.75rem;
    bottom: 1.5rem;
    padding: 0.4rem 0.9rem;
    background: #ffd60a;
    color: #0a0e27;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    transform: rotate(-6deg);
  }

  @media (max-width: 1023px) {
    header {
      min-height: auto;
    }

    .hero-photo {
      transform: none;
    }
  }
</style>
