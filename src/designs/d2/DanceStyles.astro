---
import { Image } from "astro:assets";

interface Props {
  photos: any;
}

const { photos } = Astro.props;

const styles = [
  {
    title: "Бачата",
    subtitle: "Язык тела в танце",
    description:
      "Бачата — это не просто танец, это разговор двух тел. Тёплый, близкий, искренний. Это специализация Дмитрия: он чувствует каждое движение и передаёт эту чувствительность своим ученикам.",
    photo: photos.danceSmile,
  },
  {
    title: "Классический танец",
    subtitle: "Вальс и медленный танец",
    description:
      "Классика — это всегда к месту на свадьбе. Элегантные линии, ясные движения, благородство в каждом шаге. Вальс подарит вам магический момент под музыку, которая кружит голову.",
    photo: photos.danceHall,
  },
  {
    title: "Микс стилей",
    subtitle: "От нежности к энергии",
    description:
      "Хотите больше? Начните с нежной бачаты, перейдите в энергичное латино, завершите классическим движением. Каждый переход — это искусство, каждый момент — запоминающийся.",
    photo: photos.danceDip,
  },
];
---

<div class="container-width">
  <div class="mb-16">
    <h2 class="text-4xl md:text-5xl font-serif italic mb-4">
      Какой танец выбрать
    </h2>
    <p class="text-lg text-[#c9a881] font-serif italic">
      Бачата — специализация Дмитрия, но он ставит любой танец
    </p>
  </div>

  <!-- Styles grid -->
  <div class="space-y-20 md:space-y-32">
    {
      styles.map((style, index) => (
        <div
          class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center"
        >
          {/* Photo */}
          <div
            class={`order-1 ${index % 2 === 1 ? "md:order-2" : "md:order-1"}`}
            data-photo-frame
          >
            <div class="aspect-square border border-[#d4a574] overflow-hidden">
              <Image
                src={style.photo.src}
                alt={style.photo.alt}
                widths={[320, 640]}
                sizes="(max-width: 768px) 90vw, 500px"
                class="w-full h-full object-cover sepia-[0.25] saturate-[0.9]"
              />
            </div>
          </div>

          {/* Text */}
          <div
            class={`order-2 ${index % 2 === 1 ? "md:order-1" : "md:order-2"}`}
          >
            <h3 class="text-3xl md:text-4xl font-serif italic mb-2">
              {style.title}
            </h3>
            <p class="text-[#d4a574] font-serif italic mb-6">
              {style.subtitle}
            </p>
            <p class="text-lg text-[#c9a881] font-serif leading-relaxed">
              {style.description}
            </p>
          </div>
        </div>
      ))
    }
  </div>

  <!-- Final message -->
  <div class="mt-24 md:mt-32 text-center border-t border-[#3d3035] pt-16">
    <p class="text-xl text-[#c9a881] font-serif italic mb-6 max-w-2xl mx-auto">
      Не уверены в выборе? Напишите Дмитрию — он подскажет, какой танец будет
      идеален именно для вас.
    </p>
  </div>
</div>
