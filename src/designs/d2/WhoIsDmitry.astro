---
import { Image } from "astro:assets";
import { site } from "../../data/site";

interface Props {
  photos: any;
}

const { photos } = Astro.props;
---

<div class="container-width">
  <div class="mb-16">
    <h2 class="text-4xl md:text-5xl font-serif italic mb-8">
      Кто такой Дмитрий
    </h2>
    <div class="prose prose-invert max-w-3xl">
      <p class="text-lg text-[#c9a881] font-serif leading-relaxed mb-6">
        Дмитрий преподаёт бачату. Он вёл группы для начинающих и
        для продолжающих танцоров, танцует на вечеринках и фестивалях, а главное
        — ставит свадебные танцы. Каждый его ученик чувствует себя уверенно и
        красиво.
      </p>
      <p class="text-lg text-[#c9a881] font-serif leading-relaxed">
        Его специализация — <em>бачата</em>. Но он ставит любые танцы: вальсы,
        медленные танцы, миксы стилей, танцы под вашу собственную музыку. Главное
        — что в его руках ваш танец становится незабываемым.
      </p>
    </div>
  </div>

  <!-- Photo grid -->
  <div class="grid grid-cols-2 md:grid-cols-3 gap-4 md:gap-6 mb-12">
    <!-- Portrait -->
    <div
      data-photo-frame
      class="col-span-1 aspect-square border border-[#d4a574] overflow-hidden"
    >
      <Image
        src={photos.portrait.src}
        alt={photos.portrait.alt}
        widths={[320, 480]}
        sizes="(max-width: 768px) 45vw, 280px"
        class="w-full h-full object-cover mix-blend-multiply filter saturate-75"
      />
    </div>

    <!-- Dance pink -->
    <div
      data-photo-frame
      class="col-span-1 md:col-span-1 aspect-square border border-[#d4a574] overflow-hidden"
    >
      <Image
        src={photos.dancePink.src}
        alt={photos.dancePink.alt}
        widths={[320, 480]}
        sizes="(max-width: 768px) 45vw, 280px"
        class="w-full h-full object-cover mix-blend-multiply filter saturate-75"
      />
    </div>

    <!-- Dance dip -->
    <div
      data-photo-frame
      class="col-span-1 md:col-span-1 aspect-square border border-[#d4a574] overflow-hidden"
    >
      <Image
        src={photos.danceDip.src}
        alt={photos.danceDip.alt}
        widths={[320, 480]}
        sizes="(max-width: 768px) 45vw, 280px"
        class="w-full h-full object-cover mix-blend-multiply filter saturate-75"
      />
    </div>

    <!-- Party wide (cropped) -->
    <div
      data-photo-frame
      class="col-span-2 md:col-span-1 aspect-square border border-[#d4a574] overflow-hidden"
    >
      <Image
        src={photos.partyWide.src}
        alt={photos.partyWide.alt}
        widths={[320, 480]}
        sizes="(max-width: 768px) 95vw, 280px"
        class="w-full h-full object-cover object-center mix-blend-multiply filter saturate-75"
      />
    </div>

    <!-- Team medals -->
    <div
      data-photo-frame
      class="col-span-1 md:col-span-1 aspect-square border border-[#d4a574] overflow-hidden"
    >
      <Image
        src={photos.teamMedals.src}
        alt={photos.teamMedals.alt}
        widths={[320, 480]}
        sizes="(max-width: 768px) 45vw, 280px"
        class="w-full h-full object-cover mix-blend-multiply filter saturate-75"
      />
    </div>
  </div>

  <!-- Instagram link -->
  <div class="text-center">
    <p class="text-[#c9a881] mb-4 font-serif">
      Смотрите танцы Дмитрия в Instagram:
    </p>
    <a
      href={site.instagramUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block button-outline"
    >
      {site.instagramHandle}
    </a>
  </div>
</div>
