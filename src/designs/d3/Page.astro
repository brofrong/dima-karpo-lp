---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "./sections/Hero.astro";
import Marquee from "./sections/Marquee.astro";
import WhoIs from "./sections/WhoIs.astro";
import WhatDance from "./sections/WhatDance.astro";
import HowItGoes from "./sections/HowItGoes.astro";
import Planner from "./sections/Planner.astro";
import FAQ from "./sections/FAQ.astro";
import CTA from "./sections/CTA.astro";
import "./styles.css";

const title = "Первый танец на одном дыхании — Дмитрий Карпов";
const description =
  "Постановка свадебного танца: бачата, вальс, микс стилей или хореография под вашу песню. Выберите дату свадьбы — календарь разложит занятия по дням.";
---

<BaseLayout title={title} description={description} themeColor="#fef8f3" variant={3}>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Jost:ital,wght@0,400..800;1,400..800&family=Montserrat:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <div class="fx-progress" data-progress aria-hidden="true"></div>

  <main class="fx-main">
    <Hero />
    <Marquee />
    <WhoIs />
    <WhatDance />
    <HowItGoes />
    <Planner />
    <FAQ />
    <CTA />
  </main>

  <script>
    import { initPage } from "./main";

    initPage();
  </script>
</BaseLayout>
