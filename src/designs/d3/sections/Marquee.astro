---
// Two ribbons crossing: the same words running in opposite directions.
const words = ["бачата", "вальс", "микс стилей", "ваша песня", "поддержки", "первый танец"];
// Four copies: the track slides by half its width, so the loop is seamless.
const loop = [...words, ...words, ...words, ...words];
---

<div class="fx-marquee" aria-hidden="true">
  <div class="fx-marquee-band fx-marquee-band-ink">
    <div data-marquee-skew>
      <div class="fx-marquee-track">{loop.map((word) => <span>{word}</span>)}</div>
    </div>
  </div>
  <div class="fx-marquee-band fx-marquee-band-warm">
    <div data-marquee-skew>
      <div class="fx-marquee-track fx-marquee-track-reverse">
        {loop.map((word) => <span>{word}</span>)}
      </div>
    </div>
  </div>
</div>
