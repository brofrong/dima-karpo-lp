---
import { helloLink } from "../../../data/site";
import { WEEKDAYS_SHORT } from "../../../lib/dates";
import { DEFAULT_SELECTION, EXTRAS, LEVELS, recommendLessons, STYLES } from "../../../lib/planner";
---

<section class="d3-planner" id="planner">
  <div class="d3-section-container">
    <h2>Спланируйте ваш танец</h2>
    <p class="d3-planner__subtitle">Выберите дату свадьбы и мы покажем программу занятий</p>

    <div data-planner class="d3-planner__widget">
      <div class="d3-planner__calendar">
        <div class="d3-planner__nav">
          <button type="button" data-planner-prev aria-label="Предыдущий месяц" class="d3-nav-btn">←</button>
          <h3 data-planner-month aria-live="polite" class="d3-planner__month"></h3>
          <button type="button" data-planner-next aria-label="Следующий месяц" class="d3-nav-btn">→</button>
        </div>

        <div class="d3-planner__weekdays" aria-hidden="true">
          {WEEKDAYS_SHORT.map((day) => <span>{day}</span>)}
        </div>

        <div class="d3-planner__grid" data-planner-grid></div>

        <noscript>Календарь работает с JavaScript. Напишите Дмитрию — он подберёт даты занятий.</noscript>
      </div>

      <div class="d3-planner__options">
        <div class="d3-planner__option-group">
          <label class="d3-planner__label">Стиль танца</label>
          <div class="d3-planner__buttons">
            {STYLES.map((style) => (
              <button
                type="button"
                data-planner-style={style.id}
                aria-pressed={style.id === DEFAULT_SELECTION.style}
                class="d3-option-btn"
                title={style.note}
              >
                {style.title}
              </button>
            ))}
          </div>
        </div>

        <div class="d3-planner__option-group">
          <label class="d3-planner__label">Ваш опыт</label>
          <div class="d3-planner__buttons">
            {LEVELS.map((level) => (
              <button
                type="button"
                data-planner-level={level.id}
                aria-pressed={level.id === DEFAULT_SELECTION.level}
                class="d3-option-btn"
                title={level.note}
              >
                {level.title}
              </button>
            ))}
          </div>
        </div>

        <div class="d3-planner__option-group">
          <label class="d3-planner__label">Дополнительно</label>
          <div class="d3-planner__buttons">
            {EXTRAS.map((extra) => (
              <button
                type="button"
                data-planner-extra={extra.id}
                aria-pressed="false"
                class="d3-option-btn d3-option-btn--extra"
                title={extra.note}
              >
                {extra.title}
              </button>
            ))}
          </div>
        </div>
      </div>

      <div class="d3-planner__result" aria-live="polite">
        <div class="d3-result-header">
          <div class="d3-result-stat">
            <span class="d3-result-stat__label">Занятий</span>
            <strong class="d3-result-stat__value" data-planner-lessons>
              {recommendLessons(DEFAULT_SELECTION)}
            </strong>
          </div>
          <div class="d3-result-stat">
            <span class="d3-result-stat__label">Дней до свадьбы</span>
            <strong class="d3-result-stat__value" data-planner-days-left>—</strong>
          </div>
        </div>

        <div class="d3-result-verdict">
          <p data-planner-headline class="d3-verdict__headline">
            Обычно хватает 5–7 занятий
          </p>
          <p data-planner-advice class="d3-verdict__advice">
            Выберите дату свадьбы — и программа разложится по дням.
          </p>
        </div>

        <div class="d3-planner__sessions">
          <ol data-planner-sessions class="d3-sessions-list"></ol>
        </div>

        <a
          data-planner-cta
          href={helloLink}
          target="_blank"
          rel="noopener noreferrer"
          class="d3-btn d3-btn--primary d3-btn--full"
        >
          Отправить программу в Telegram
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import { mountPlanner } from "../planner-client";

  for (const root of document.querySelectorAll<HTMLElement>("[data-planner]")) {
    mountPlanner(root);
  }
</script>

<style>
  .d3-planner {
    padding: 4rem 1rem;
    background: linear-gradient(135deg, #fef8f3 0%, #fff0e6 100%);
  }

  @media (min-width: 768px) {
    .d3-planner {
      padding: 6rem 2rem;
    }
  }

  .d3-section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .d3-planner h2 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 700;
    color: #2d3436;
    margin-bottom: 0.5rem;
    text-align: center;
  }

  .d3-planner__subtitle {
    text-align: center;
    color: #999;
    margin-bottom: 2rem;
  }

  [data-planner] {
    background: white;
    border-radius: 1.5rem;
    padding: 2rem;
    box-shadow: 0 4px 24px rgba(0, 0, 0, 0.08);
  }

  @media (min-width: 768px) {
    [data-planner] {
      padding: 3rem;
    }
  }

  .d3-planner__calendar {
    margin-bottom: 2rem;
  }

  .d3-planner__nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.5rem;
  }

  .d3-planner__month {
    font-size: 1.25rem;
    font-weight: 700;
    color: #2d3436;
    font-family: "Jost", sans-serif;
    margin: 0;
  }

  .d3-nav-btn {
    width: 40px;
    height: 40px;
    border: 2px solid #ff9500;
    background: transparent;
    color: #ff9500;
    border-radius: 0.5rem;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .d3-nav-btn:hover:not(:disabled) {
    background: #ff9500;
    color: white;
  }

  .d3-nav-btn:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .d3-planner__weekdays,
  .d3-planner__grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
    gap: 0.5rem;
    text-align: center;
  }

  .d3-planner__weekdays {
    margin-bottom: 1rem;
  }

  .d3-planner__weekdays span {
    font-size: 0.8rem;
    font-weight: 600;
    color: #999;
    padding: 0.5rem 0;
  }

  .d3-planner__grid button {
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px solid #ddd;
    background: white;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: #2d3436;
    cursor: pointer;
    transition: all 0.3s ease;
    min-height: 40px;
    min-width: 40px;
  }

  .d3-planner__grid button:hover:not(:disabled) {
    border-color: #ff9500;
    background: #fff9f0;
  }

  .d3-planner__grid button[data-today] {
    border-color: #0064ff;
    background: #f0f4ff;
    font-weight: 700;
  }

  .d3-planner__grid button[aria-pressed="true"] {
    background: #ff9500;
    color: white;
    border-color: #ff9500;
    font-weight: 700;
  }

  .d3-planner__grid button[data-lesson] {
    box-shadow: inset 0 0 0 2px #0064ff;
  }

  .d3-planner__grid button:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .d3-planner__options {
    border-top: 1px solid #eee;
    padding-top: 2rem;
    margin-bottom: 2rem;
  }

  .d3-planner__option-group {
    margin-bottom: 1.5rem;
  }

  .d3-planner__label {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: #2d3436;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.75rem;
  }

  .d3-planner__buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .d3-option-btn {
    padding: 0.6rem 1.2rem;
    border: 2px solid #ddd;
    background: white;
    color: #2d3436;
    border-radius: 0.5rem;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    min-height: 40px;
  }

  .d3-option-btn:hover {
    border-color: #ff9500;
  }

  .d3-option-btn[aria-pressed="true"] {
    background: #ff9500;
    color: white;
    border-color: #ff9500;
  }

  .d3-option-btn:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .d3-planner__result {
    border-top: 1px solid #eee;
    padding-top: 2rem;
  }

  .d3-result-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #eee;
  }

  @media (min-width: 768px) {
    .d3-result-header {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .d3-result-stat {
    display: flex;
    flex-direction: column;
  }

  .d3-result-stat__label {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    color: #999;
    margin-bottom: 0.5rem;
    letter-spacing: 0.05em;
  }

  .d3-result-stat__value {
    font-size: 2rem;
    font-weight: 700;
    color: #ff9500;
    font-family: "Jost", sans-serif;
  }

  .d3-result-verdict {
    margin-bottom: 2rem;
  }

  .d3-verdict__headline {
    font-size: 1.25rem;
    font-weight: 700;
    color: #2d3436;
    margin: 0 0 0.5rem 0;
    font-family: "Jost", sans-serif;
  }

  .d3-verdict__advice {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
    margin: 0;
  }

  .d3-planner__sessions {
    margin-bottom: 1.5rem;
  }

  .d3-sessions-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .d3-sessions-list li {
    padding: 1rem;
    background: #f9f9f9;
    border-left: 4px solid #0064ff;
    border-radius: 0.25rem;
    font-size: 0.9rem;
    line-height: 1.6;
    color: #555;
  }

  .d3-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
    border: none;
    min-width: 40px;
    min-height: 40px;
  }

  .d3-btn--full {
    width: 100%;
    padding: 1rem 1.5rem;
    min-height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  @media (prefers-reduced-motion: reduce) {
    .d3-nav-btn,
    .d3-planner__grid button,
    .d3-option-btn {
      transition: none;
    }
  }
</style>
