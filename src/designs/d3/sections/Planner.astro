---
import { helloLink } from "../../../data/site";
import { WEEKDAYS_SHORT } from "../../../lib/dates";
import { DEFAULT_SELECTION, EXTRAS, LEVELS, STYLES, recommendLessons } from "../../../lib/planner";
import Arrow from "./Arrow.astro";
---

<section id="planner" class="px-2 sm:px-4">
  <div
    class="relative overflow-hidden rounded-[2rem] bg-ink px-3 py-16 text-cream sm:rounded-[3rem] sm:px-8 md:py-24"
  >
    <div class="fx-orb -top-24 -right-16 h-96 w-96 bg-flame/35" aria-hidden="true"></div>
    <div class="fx-orb -bottom-32 -left-24 h-96 w-96 bg-sea/40" aria-hidden="true"></div>

    <div class="relative mx-auto max-w-[74rem]">
      <div class="max-w-2xl px-2">
        <p class="fx-kicker" data-reveal>Календарь подготовки</p>
        <h2 class="mt-5" data-reveal>Соберите свою <span class="fx-grad">программу</span></h2>
        <p class="mt-5 text-lg text-cream/75" data-reveal>
          Выберите дату свадьбы, стиль и пожелания — календарь покажет, сколько занятий понадобится, и разложит
          их по дням.
        </p>
      </div>

      <div
        data-planner
        class="mt-10 grid gap-5 rounded-[1.75rem] bg-cream p-3.5 text-ink sm:rounded-[2.5rem] sm:p-6 lg:grid-cols-[1.1fr_0.9fr] lg:gap-8 lg:p-8"
      >
        <div>
          <h3>Дата свадьбы</h3>
          <div class="mt-5 flex items-center justify-between gap-3">
            <button type="button" class="fx-cal-nav" data-planner-prev aria-label="Предыдущий месяц">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
                <path
                  d="M10 3 5 8l5 5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
            <strong class="min-h-7 font-display text-xl font-semibold" data-planner-month aria-live="polite"
            ></strong>
            <button type="button" class="fx-cal-nav" data-planner-next aria-label="Следующий месяц">
              <svg viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true">
                <path
                  d="m6 3 5 5-5 5"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </button>
          </div>

          <div
            class="fx-cal-grid mt-5 text-center text-xs font-bold tracking-wider text-ink/55 uppercase"
            aria-hidden="true"
          >
            {WEEKDAYS_SHORT.map((day) => <span>{day}</span>)}
          </div>
          <div class="fx-cal-grid mt-2" data-planner-grid></div>
          <noscript>
            <p class="mt-4 rounded-2xl bg-sand p-4 text-sm">
              Календарь работает с JavaScript. Напишите Дмитрию — он подберёт даты занятий.
            </p>
          </noscript>

          <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-xs font-semibold text-ink/70">
            <li class="fx-legend fx-legend-today">сегодня</li>
            <li class="fx-legend fx-legend-lesson">занятие</li>
            <li class="fx-legend fx-legend-wedding">свадьба</li>
          </ul>
        </div>

        <div class="mt-4 lg:mt-0">
          <h3>Ваш танец</h3>
          <div class="mt-5 grid gap-6">
            <div role="group" aria-labelledby="fx-planner-style">
              <h4 id="fx-planner-style" class="text-xs font-bold tracking-wider text-ink/60 uppercase">Стиль танца</h4>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  STYLES.map((style) => (
                    <button
                      type="button"
                      class="fx-chip"
                      data-planner-style={style.id}
                      aria-pressed={style.id === DEFAULT_SELECTION.style}
                    >
                      {style.title}
                    </button>
                  ))
                }
              </div>
            </div>
            <div role="group" aria-labelledby="fx-planner-level">
              <h4 id="fx-planner-level" class="text-xs font-bold tracking-wider text-ink/60 uppercase">
                Опыт в танцах
              </h4>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  LEVELS.map((level) => (
                    <button
                      type="button"
                      class="fx-chip"
                      data-planner-level={level.id}
                      aria-pressed={level.id === DEFAULT_SELECTION.level}
                    >
                      {level.title}
                    </button>
                  ))
                }
              </div>
            </div>
            <div role="group" aria-labelledby="fx-planner-extra">
              <h4 id="fx-planner-extra" class="text-xs font-bold tracking-wider text-ink/60 uppercase">
                Добавить в программу
              </h4>
              <div class="mt-3 flex flex-wrap gap-2">
                {
                  EXTRAS.map((extra) => (
                    <button type="button" class="fx-chip" data-planner-extra={extra.id} aria-pressed="false">
                      {extra.title}
                    </button>
                  ))
                }
              </div>
            </div>
          </div>
        </div>

        <div class="rounded-[1.5rem] bg-sand p-4 sm:rounded-[2rem] sm:p-7 lg:col-span-2" aria-live="polite">
          <div class="grid gap-6 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.2fr)] lg:items-center lg:gap-10">
            <div class="grid grid-cols-2 gap-3">
              <div class="rounded-[1.25rem] bg-white p-4">
                <p class="text-xs font-bold tracking-wider text-ink/60 uppercase">Занятий</p>
                <p class="mt-2">
                  <span class="fx-stat text-coral" data-planner-lessons>{recommendLessons(DEFAULT_SELECTION)}</span>
                </p>
              </div>
              <div class="rounded-[1.25rem] bg-white p-4">
                <p class="text-xs font-bold tracking-wider text-ink/60 uppercase">Дней до свадьбы</p>
                <p class="mt-2">
                  <span class="fx-stat text-sea" data-planner-days-left>—</span>
                </p>
              </div>
            </div>
            <div>
              <p class="font-display text-2xl leading-tight font-bold md:text-3xl" data-planner-headline>
                Обычно хватает 5–7 занятий
              </p>
              <p class="mt-2 text-ink/80" data-planner-advice>
                Выберите дату свадьбы — и программа разложится по дням.
              </p>
            </div>
          </div>

          <ol class="fx-sessions mt-6" data-planner-sessions></ol>

          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
            <a
              data-planner-cta
              href={helloLink}
              target="_blank"
              rel="noopener noreferrer"
              class="fx-btn fx-btn-primary"
            >
              Отправить программу в Telegram
              <Arrow />
            </a>
            <p class="max-w-xs text-xs text-ink/65">
              Откроется Telegram с готовым сообщением — останется нажать «Отправить».
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
