---
import { helloLink } from "../../../data/site";
import Arrow from "./Arrow.astro";

const questions = [
  {
    question: "Мы никогда не танцевали. Получится?",
    answer:
      "Да. Дмитрий работает и с парами, которые никогда раньше не танцевали. Хореография подбирается под ваш уровень, а на подготовку обычно хватает 5–7 занятий.",
  },
  {
    question: "А если до свадьбы мало времени?",
    answer:
      "Напишите Дмитрию как можно раньше. Лучше всего начинать за месяц-два, но если времени меньше — можно выбрать танец попроще и успеть его выучить.",
  },
  {
    question: "Сколько это стоит?",
    answer: "Цену, место и расписание Дмитрий обсуждает лично в Telegram — напишите ему, и он всё расскажет.",
  },
  {
    question: "Можно танец под нашу песню?",
    answer: "Да. Хореография строится вокруг вас: вашей песни, уровня, платья и размера площадки.",
  },
  {
    question: "Только бачата?",
    answer:
      "Бачата — специализация Дмитрия, но он ставит и любой другой свадебный танец: вальс, медленный танец, микс стилей.",
  },
  {
    question: "Где проходят занятия?",
    answer: "Место и расписание подбираются под вас — договоритесь с Дмитрием в Telegram.",
  },
];
---

<section id="faq" class="fx-section">
  <div class="fx-wrap grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
    <div class="lg:sticky lg:top-24 lg:self-start">
      <p class="fx-kicker" data-reveal>Вопросы</p>
      <h2 class="mt-5" data-reveal>Коротко о <span class="fx-grad">главном</span></h2>
      <p class="mt-6 text-lg text-ink/80" data-reveal>Не нашли ответ? Спросите Дмитрия напрямую.</p>
      <div class="mt-7" data-reveal>
        <a
          href={helloLink}
          target="_blank"
          rel="noopener noreferrer"
          class="fx-btn fx-btn-ghost"
          data-magnetic
        >
          Задать вопрос в Telegram
          <Arrow />
        </a>
      </div>
    </div>

    <div class="grid gap-3">
      {
        questions.map((item) => (
          <details class="fx-faq" data-reveal>
            <summary>
              <span>{item.question}</span>
              <span class="fx-faq-mark" aria-hidden="true">
                +
              </span>
            </summary>
            <p class="text-ink/80">{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
