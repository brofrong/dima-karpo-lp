---
import { Image } from "astro:assets";
import { photos } from "../../../data/photos";
import { site } from "../../../data/site";
import Arrow from "./Arrow.astro";
---

<section id="about" class="fx-section">
  <div class="fx-orb top-10 -left-24 h-72 w-72 bg-flame/25" aria-hidden="true"></div>

  <div class="fx-wrap relative grid items-center gap-14 lg:grid-cols-2 lg:gap-20">
    <div data-parallax="6">
      <div class="fx-collage">
        <div class="fx-collage-main" data-reveal="left">
          <Image
            src={photos.teamMedals.src}
            alt={photos.teamMedals.alt}
            widths={[420, 640]}
            sizes="(max-width: 1024px) 80vw, 430px"
          />
        </div>
        <div class="fx-collage-party" data-reveal="right">
          <Image
            src={photos.partyWide.src}
            alt={photos.partyWide.alt}
            widths={[240, 480]}
            sizes="(max-width: 1024px) 45vw, 240px"
          />
        </div>
        <div class="fx-collage-portrait" data-reveal="zoom">
          <div class="fx-blob">
            <Image
              src={photos.portrait.src}
              alt={photos.portrait.alt}
              widths={[200, 320]}
              sizes="(max-width: 1024px) 36vw, 195px"
            />
          </div>
        </div>
        <p class="fx-collage-chip" data-reveal="zoom">Бачата — специализация</p>
      </div>
    </div>

    <div>
      <p class="fx-kicker" data-reveal>Кто ставит танец</p>
      <h2 class="mt-5" data-reveal>Знакомьтесь — <span class="fx-grad">Дмитрий</span></h2>
      <div class="mt-7 grid gap-4 text-lg text-ink/80">
        <p data-reveal>
          {site.name} — преподаватель бачаты и постановщик свадебных танцев. Вёл группы для начинающих и
          продолжающих, сам танцует на вечеринках и фестивалях.
        </p>
        <p data-reveal>
          Бачата — его специализация, но поставить можно любой свадебный танец: вальс, медленный танец, микс
          стилей или номер под вашу любимую песню.
        </p>
        <p data-reveal>
          Хореография строится вокруг вас: вашей песни, уровня, платья и размера площадки. Опыт не нужен —
          Дмитрий работает и с парами, которые никогда не танцевали.
        </p>
      </div>
      <div class="mt-9" data-reveal>
        <a
          href={site.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="fx-btn fx-btn-ghost"
          data-magnetic
        >
          Смотреть танцы в Instagram
          <Arrow />
        </a>
      </div>
    </div>
  </div>
</section>
