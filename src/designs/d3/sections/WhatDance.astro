---
import { Image } from "astro:assets";
import { photos } from "../../../data/photos";

const rows = [
  { title: "Бачата", note: "Тёплый, близкий танец — специализация Дмитрия." },
  { title: "Вальс и медленный танец", note: "Классика, которая всегда к месту." },
  { title: "Микс стилей", note: "Начинаем нежно, заканчиваем зажигательно." },
  { title: "Ваша песня", note: "Приносите любимый трек — хореография под него." },
];
---

<section id="styles" class="fx-section rounded-[2.5rem] bg-sand md:rounded-[4rem]">
  <div class="fx-wrap">
    <div class="max-w-3xl">
      <p class="fx-kicker" data-reveal>Любой стиль</p>
      <h2 class="mt-5" data-reveal>Что будем <span class="fx-grad">танцевать</span></h2>
    </div>

    <ul class="mt-12 md:mt-16">
      {
        rows.map((row, index) => (
          <li class="fx-row" data-reveal={index % 2 === 0 ? "left" : "right"}>
            <span class="fx-row-num" aria-hidden="true">
              0{index + 1}
            </span>
            <h3 class="fx-row-title">{row.title}</h3>
            <p class="fx-row-note">{row.note}</p>
          </li>
        ))
      }
    </ul>

    <div class="mt-12 grid grid-cols-2 gap-3 md:mt-16 md:gap-5 lg:grid-cols-3">
      <div class="fx-tile aspect-square lg:aspect-auto" data-reveal>
        <Image
          src={photos.danceHall.src}
          alt={photos.danceHall.alt}
          widths={[320, 640]}
          sizes="(max-width: 1024px) 46vw, 380px"
        />
      </div>
      <div class="fx-tile aspect-square lg:aspect-[4/5]" data-reveal>
        <Image
          src={photos.danceDip.src}
          alt={photos.danceDip.alt}
          widths={[240, 360]}
          sizes="(max-width: 1024px) 46vw, 380px"
        />
      </div>
      <div class="fx-tile fx-tile-text col-span-2 min-h-56 lg:col-span-1" data-reveal>
        <h3>Поддержки и эффектный финал</h3>
        <p class="mt-3 font-medium text-ink/85">
          Наклон, поддержка, красивая точка в конце — добавим, если захотите.
        </p>
      </div>
    </div>
  </div>
</section>
