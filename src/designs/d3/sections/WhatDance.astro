---
import { Image } from "astro:assets";
import { photos } from "../../../data/photos";
---

<section class="d3-whatdance" id="whatdance">
  <div class="d3-section-container">
    <h2>Какие танцы мы ставим</h2>

    <div class="d3-dances">
      <div class="d3-dance-card">
        <div class="d3-dance-icon">🎵</div>
        <h3>Бачата</h3>
        <p>Тёплый, близкий танец — это специальность Дмитрия. Легко, нежно, с настоящей импровизацией.</p>
        <span class="d3-dance-badge">Специализация</span>
      </div>

      <div class="d3-dance-card">
        <div class="d3-dance-icon">💃</div>
        <h3>Вальс</h3>
        <p>Классика, которая всегда вписывается. Элегантность и красота в каждом шаге.</p>
      </div>

      <div class="d3-dance-card">
        <div class="d3-dance-icon">✨</div>
        <h3>Микс стилей</h3>
        <p>Начинаем нежно, заканчиваем зажигательно. Или наоборот — ваша история, ваш выбор.</p>
      </div>
    </div>

    <!-- Featured photo -->
    <div class="d3-whatdance__photo">
      <Image
        src={photos.danceHall.src}
        alt={photos.danceHall.alt}
        widths={[320, 640]}
        sizes="(max-width: 768px) 100vw, 600px"
        class="d3-whatdance__image"
      />
      <div class="d3-whatdance__photo-bg"></div>
    </div>
  </div>
</section>

<style>
  .d3-whatdance {
    padding: 4rem 1rem;
    background: linear-gradient(135deg, #fef8f3 0%, #fff0e6 100%);
    position: relative;
  }

  @media (min-width: 768px) {
    .d3-whatdance {
      padding: 6rem 2rem;
    }
  }

  .d3-section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .d3-whatdance h2 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 700;
    color: #2d3436;
    margin-bottom: 3rem;
    text-align: center;
  }

  .d3-dances {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  @media (min-width: 768px) {
    .d3-dances {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      margin-bottom: 4rem;
    }
  }

  .d3-dance-card {
    padding: 2rem;
    background: white;
    border-radius: 1rem;
    text-align: center;
    animation: card-enter 0.6s ease-out backwards;
    border: 2px solid transparent;
    transition: all 0.3s ease;
  }

  .d3-dance-card:nth-child(1) {
    animation-delay: 0.1s;
    border-color: #ff9500;
  }

  .d3-dance-card:nth-child(2) {
    animation-delay: 0.2s;
  }

  .d3-dance-card:nth-child(3) {
    animation-delay: 0.3s;
    border-color: #0064ff;
  }

  .d3-dance-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 12px 24px rgba(255, 149, 0, 0.15);
  }

  @keyframes card-enter {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .d3-dance-icon {
    font-size: 3rem;
    margin-bottom: 1rem;
    display: block;
  }

  .d3-dance-card h3 {
    font-size: 1.5rem;
    color: #2d3436;
    margin-bottom: 1rem;
    font-family: "Jost", sans-serif;
  }

  .d3-dance-card p {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #666;
    margin-bottom: 1rem;
  }

  .d3-dance-badge {
    display: inline-block;
    background: linear-gradient(135deg, #ff9500, #f09433);
    color: white;
    padding: 0.4rem 0.8rem;
    border-radius: 0.25rem;
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .d3-whatdance__photo {
    position: relative;
    max-width: 600px;
    margin: 0 auto;
    border-radius: 1rem;
    overflow: hidden;
    aspect-ratio: 4/3;
    animation: photo-float 0.8s ease-out 0.4s backwards;
  }

  @keyframes photo-float {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .d3-whatdance__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .d3-whatdance__photo-bg {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 100, 255, 0.1) 100%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .d3-dance-card,
    .d3-whatdance__photo {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>
