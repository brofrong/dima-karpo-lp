---
import { site, helloLink } from "../../../data/site";
---

<section class="d3-cta">
  <div class="d3-section-container">
    <div class="d3-cta__content">
      <h2>Готовы начать?</h2>
      <p>
        Напишите Дмитрию в Telegram — обсудите дату, стиль, ваши пожелания. Ответ приходит сразу.
      </p>

      <div class="d3-cta__buttons">
        <a href={helloLink} target="_blank" rel="noopener noreferrer" class="d3-btn d3-btn--primary d3-btn--large">
          Написать в Telegram
        </a>
        <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="d3-btn d3-btn--secondary d3-btn--large">
          Смотреть на Instagram
        </a>
      </div>
    </div>
  </div>
</section>

<footer class="d3-footer">
  <div class="d3-section-container">
    <div class="d3-footer__content">
      <div class="d3-footer__column">
        <h3>Дмитрий Карпов</h3>
        <p>Постановщик свадебных танцев и преподаватель бачаты</p>
      </div>

      <div class="d3-footer__column">
        <h4>Контакты</h4>
        <ul class="d3-footer__list">
          <li>
            <a href={helloLink} target="_blank" rel="noopener noreferrer">
              {site.telegramHandle}
            </a>
          </li>
          <li>
            <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
              {site.instagramHandle}
            </a>
          </li>
        </ul>
      </div>

      <div class="d3-footer__column">
        <h4>Страницы</h4>
        <ul class="d3-footer__list">
          <li><a href="#hero">Главная</a></li>
          <li><a href="#whois">Кто такой Дмитрий</a></li>
          <li><a href="#whatdance">Какие танцы</a></li>
          <li><a href="#howitgoes">Как это работает</a></li>
          <li><a href="#planner">Спланировать</a></li>
          <li><a href="#faq">FAQ</a></li>
        </ul>
      </div>
    </div>

    <div class="d3-footer__bottom">
      <p>&copy; 2024 Дмитрий Карпов. Все права защищены.</p>
    </div>
  </div>
</footer>

<style>
  .d3-cta {
    padding: 4rem 1rem;
    background: linear-gradient(135deg, #ff9500 0%, #f09433 100%);
    color: white;
  }

  @media (min-width: 768px) {
    .d3-cta {
      padding: 6rem 2rem;
    }
  }

  .d3-section-container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .d3-cta__content {
    text-align: center;
    max-width: 600px;
    margin: 0 auto;
  }

  .d3-cta h2 {
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 700;
    color: white;
    margin-bottom: 1rem;
  }

  .d3-cta p {
    font-size: 1.1rem;
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .d3-cta__buttons {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    justify-content: center;
  }

  @media (min-width: 768px) {
    .d3-cta__buttons {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 1.5rem;
    }
  }

  .d3-btn--large {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .d3-btn--primary {
    background-color: white;
    color: #ff9500;
  }

  .d3-btn--primary:hover {
    background-color: #f5f5f5;
  }

  .d3-btn--secondary {
    background-color: transparent;
    color: white;
    border: 2px solid white;
  }

  .d3-btn--secondary:hover {
    background-color: rgba(255, 255, 255, 0.1);
  }

  .d3-footer {
    padding: 4rem 1rem 2rem;
    background: #2d3436;
    color: #ccc;
    border-top: 4px solid #ff9500;
  }

  @media (min-width: 768px) {
    .d3-footer {
      padding: 6rem 2rem 2rem;
    }
  }

  .d3-footer__content {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  @media (min-width: 768px) {
    .d3-footer__content {
      grid-template-columns: repeat(3, 1fr);
      gap: 4rem;
      margin-bottom: 3rem;
    }
  }

  .d3-footer__column h3,
  .d3-footer__column h4 {
    font-size: 1.1rem;
    font-weight: 700;
    color: white;
    margin-bottom: 0.75rem;
    font-family: "Jost", sans-serif;
  }

  .d3-footer__column p {
    font-size: 0.9rem;
    line-height: 1.6;
    margin: 0;
  }

  .d3-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .d3-footer__list a {
    color: #ccc;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.3s ease;
  }

  .d3-footer__list a:hover {
    color: #ff9500;
  }

  .d3-footer__bottom {
    text-align: center;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 149, 0, 0.2);
    font-size: 0.85rem;
    color: #999;
  }
</style>
