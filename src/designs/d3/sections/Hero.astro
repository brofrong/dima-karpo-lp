---
import { Image } from "astro:assets";
import { photos } from "../../../data/photos";
import { helloLink, site } from "../../../data/site";
import Arrow from "./Arrow.astro";

const links = [
  { href: "#about", label: "Преподаватель" },
  { href: "#styles", label: "Стили" },
  { href: "#how", label: "Как проходит" },
  { href: "#planner", label: "Календарь" },
  { href: "#faq", label: "Вопросы" },
];
const tags = ["Бачата", "Вальс", "Микс стилей", "Ваша песня"];
---

<section id="top" class="fx-hero" data-hero>
  <canvas class="fx-hero-canvas" data-flow-canvas aria-hidden="true"></canvas>

  <div class="fx-wrap relative z-10">
    <div class="flex items-center justify-between gap-4 py-5" data-hero-item>
      <a href="#top" class="font-display text-xl font-bold tracking-tight">{site.name}</a>
      <nav class="hidden items-center gap-7 text-sm font-semibold lg:flex" aria-label="Разделы">
        {
          links.map((link) => (
            <a href={link.href} class="fx-link">
              {link.label}
            </a>
          ))
        }
      </nav>
      <a
        href={helloLink}
        target="_blank"
        rel="noopener noreferrer"
        class="rounded-full bg-ink px-5 py-2.5 text-sm font-bold text-cream transition-colors hover:bg-sea"
      >
        Telegram
      </a>
    </div>

    <div
      class="grid items-center gap-14 pt-8 pb-20 lg:grid-cols-[1.15fr_0.85fr] lg:gap-10 lg:pt-12 lg:pb-28"
    >
      <div>
        <p class="fx-kicker" data-hero-item>Постановка свадебного танца</p>
        <h1 class="mt-6" data-hero-title>
          <span class="fx-line"><span>Первый танец</span></span>{" "}
          <span class="fx-line"><span>на одном</span></span>{" "}
          <span class="fx-line"><span class="fx-grad">дыхании</span></span>
        </h1>
        <p class="mt-7 max-w-xl text-lg text-ink/80 md:text-xl" data-hero-item>
          {site.name} ставит свадебные танцы — бачату, вальс, микс стилей или хореографию под вашу песню.
          Обычно хватает {site.typicalLessons}, даже если вы никогда не танцевали.
        </p>
        <div class="mt-9 flex flex-wrap gap-3" data-hero-item>
          <a
            href={helloLink}
            target="_blank"
            rel="noopener noreferrer"
            class="fx-btn fx-btn-primary"
            data-magnetic
          >
            Написать в Telegram
            <Arrow />
          </a>
          <a href="#planner" class="fx-btn fx-btn-ghost" data-magnetic>
            Собрать программу
            <Arrow />
          </a>
        </div>
        <ul class="mt-8 flex flex-wrap gap-2" data-hero-item>
          {tags.map((tag) => <li class="fx-tag">{tag}</li>)}
        </ul>
      </div>

      <div data-hero-visual>
        <div class="fx-hero-visual">
          <div class="fx-hero-ring" data-hero-pop aria-hidden="true"></div>
          <div class="fx-hero-main fx-blob" data-hero-pop>
            <Image
              src={photos.danceSmile.src}
              alt={photos.danceSmile.alt}
              widths={[400, 640]}
              sizes="(max-width: 1024px) 85vw, 440px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <div class="fx-hero-mini fx-blob" data-hero-pop>
            <Image
              src={photos.dancePink.src}
              alt={photos.dancePink.alt}
              widths={[180, 360]}
              sizes="170px"
              loading="eager"
            />
          </div>
          <div class="fx-hero-badge" data-hero-pop aria-hidden="true">
            <svg viewBox="0 0 120 120">
              <defs>
                <path id="fx-badge-circle" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1 -88 0"></path>
              </defs>
              <g class="fx-hero-badge-ring">
                <text
                  fill="currentColor"
                  font-family="Jost, sans-serif"
                  font-size="11"
                  font-weight="600"
                >
                  <textPath href="#fx-badge-circle" textLength="270" lengthAdjust="spacing"
                    >СВАДЕБНЫЙ ТАНЕЦ • БАЧАТА • ВАЛЬС •</textPath
                  >
                </text>
              </g>
              <path
                d="M60 73c-9-6.4-14-11.3-14-17a7.6 7.6 0 0 1 14-4 7.6 7.6 0 0 1 14 4c0 5.7-5 10.6-14 17z"
                fill="#ff6b6b"></path>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
