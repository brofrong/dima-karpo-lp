---
import { Image } from "astro:assets";
import { helloLink } from "../../../data/site";
import { photos } from "../../../data/photos";
---

<section class="d3-hero" id="hero">
  <div class="d3-hero__content">
    <div class="d3-hero__text">
      <h1 class="d3-hero__title">
        Движение начинается с одного шага
      </h1>
      <p class="d3-hero__subtitle">
        Свадебный танец, который вы будете помнить всегда
      </p>
      <div class="d3-hero__ctas">
        <a href={helloLink} target="_blank" rel="noopener noreferrer" class="d3-btn d3-btn--primary">
          Написать в Telegram
        </a>
        <a href="#planner" class="d3-btn d3-btn--secondary">
          Спланировать
        </a>
      </div>
    </div>

    <svg
      class="d3-hero__svg"
      viewBox="0 0 500 600"
      xmlns="http://www.w3.org/2000/svg"
      aria-hidden="true"
    >
      <!-- Flowing curved shape -->
      <path
        d="M 250 50 Q 350 100 350 250 Q 350 400 250 500 Q 150 400 150 250 Q 150 100 250 50 Z"
        fill="none"
        stroke="#ff9500"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="d3-hero__path"
      />
      <!-- Inner flowing curves -->
      <path
        d="M 250 100 Q 300 150 300 250 Q 300 350 250 400 Q 200 350 200 250 Q 200 150 250 100"
        fill="none"
        stroke="#0064ff"
        stroke-width="2"
        stroke-linecap="round"
        opacity="0.6"
        class="d3-hero__path-inner"
      />
      <!-- Accent circles (interactive) -->
      <circle cx="250" cy="80" r="8" fill="#ff6b6b" class="d3-hero__accent d3-interactive-circle" data-interactive />
      <circle cx="350" cy="250" r="6" fill="#ff9500" class="d3-hero__accent d3-interactive-circle" data-interactive />
      <circle cx="150" cy="250" r="6" fill="#0064ff" class="d3-hero__accent d3-interactive-circle" data-interactive />
      <circle cx="250" cy="480" r="8" fill="#f09433" class="d3-hero__accent d3-interactive-circle" data-interactive />
    </svg>
  </div>

  <div class="d3-hero__photo">
    <Image
      src={photos.danceSmile.src}
      alt={photos.danceSmile.alt}
      widths={[320, 640]}
      sizes="(max-width: 768px) 100vw, 50vw"
      class="d3-hero__image"
    />
    <div class="d3-hero__photo-overlay"></div>
  </div>

  <div class="d3-hero__scroll-hint">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
      <path d="M12 5v10M12 19v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
      <path d="M8 15l4 4 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
    <span class="sr-only">Прокрутите вниз</span>
  </div>
</section>

<style>
  .d3-hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rem 1rem;
    background: linear-gradient(135deg, #fef8f3 0%, #fff5e6 100%);
    gap: 2rem;
  }

  @media (min-width: 768px) {
    .d3-hero {
      flex-direction: row;
      gap: 4rem;
      padding: 4rem 2rem;
      min-height: 100vh;
    }
  }

  .d3-hero__content {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 3rem;
  }

  @media (min-width: 768px) {
    .d3-hero__content {
      order: 1;
    }
  }

  .d3-hero__text {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .d3-hero__title {
    font-size: clamp(2rem, 8vw, 3.5rem);
    font-weight: 700;
    line-height: 1.1;
    color: #2d3436;
    font-family: "Jost", sans-serif;
    letter-spacing: -0.02em;
  }

  .d3-hero__subtitle {
    font-size: clamp(1rem, 2vw, 1.25rem);
    color: #666;
    line-height: 1.6;
    max-width: 500px;
  }

  .d3-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1rem;
  }

  .d3-btn {
    display: inline-block;
    padding: 0.75rem 1.5rem;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    border-radius: 0.5rem;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    cursor: pointer;
    border: none;
    min-width: 40px;
    min-height: 40px;
  }

  .d3-btn--primary {
    background-color: #ff9500;
    color: white;
  }

  .d3-btn--primary:hover {
    transform: scale(1.05);
    box-shadow: 0 4px 12px rgba(255, 149, 0, 0.3);
  }

  .d3-btn--secondary {
    background-color: transparent;
    color: #ff9500;
    border: 2px solid #ff9500;
  }

  .d3-btn--secondary:hover {
    background-color: #ff9500;
    color: white;
  }

  .d3-hero__svg {
    width: 100%;
    max-width: 300px;
    height: auto;
  }

  @media (min-width: 768px) {
    .d3-hero__svg {
      order: 2;
      max-width: 400px;
      flex: 0 0 auto;
    }
  }

  .d3-hero__path {
    animation: draw-path 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  .d3-hero__path-inner {
    animation: draw-path 1s cubic-bezier(0.34, 1.56, 0.64, 1) 0.2s forwards;
  }

  .d3-hero__accent {
    animation: accent-pop 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
    opacity: 0;
  }

  .d3-hero__accent:nth-of-type(5) {
    animation-delay: 0.3s;
  }

  .d3-hero__accent:nth-of-type(6) {
    animation-delay: 0.35s;
  }

  .d3-hero__accent:nth-of-type(7) {
    animation-delay: 0.4s;
  }

  .d3-hero__accent:nth-of-type(8) {
    animation-delay: 0.45s;
  }

  @keyframes draw-path {
    from {
      stroke-dasharray: 1000;
      stroke-dashoffset: 1000;
      opacity: 0;
    }
    to {
      stroke-dasharray: 1000;
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }

  @keyframes accent-pop {
    0% {
      opacity: 0;
      transform: scale(0);
    }
    100% {
      opacity: 1;
      transform: scale(1);
    }
  }

  .d3-hero__photo {
    position: relative;
    flex: 1;
    width: 100%;
    max-width: 400px;
    aspect-ratio: 1;
    border-radius: 30% 70% 70% 30% / 30% 30% 70% 70%;
    overflow: hidden;
    animation: fade-in 1s ease-out 0.5s backwards;
  }

  @media (min-width: 768px) {
    .d3-hero__photo {
      order: 3;
      max-width: 350px;
    }
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  .d3-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .d3-hero__photo-overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: radial-gradient(ellipse at center, transparent 0%, rgba(255, 149, 0, 0.15) 100%);
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .d3-hero__scroll-hint {
    position: absolute;
    bottom: 2rem;
    left: 50%;
    transform: translateX(-50%);
    color: #ff9500;
    animation: bounce 1s ease-in-out infinite 1s;
    font-size: 0.875rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  @keyframes bounce {
    0%, 100% {
      transform: translateX(-50%) translateY(0);
    }
    50% {
      transform: translateX(-50%) translateY(-8px);
    }
  }

  .d3-interactive-circle {
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  .d3-interactive-circle:hover {
    filter: drop-shadow(0 0 8px rgba(255, 149, 0, 0.4));
  }

  @media (prefers-reduced-motion: reduce) {
    .d3-hero__scroll-hint {
      display: none;
    }

    .d3-hero__path,
    .d3-hero__path-inner,
    .d3-hero__accent {
      animation: none;
      opacity: 1 !important;
      stroke-dashoffset: 0;
    }
  }
</style>
