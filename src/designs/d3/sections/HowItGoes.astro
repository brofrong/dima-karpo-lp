---
import { site } from "../../../data/site";
import Arrow from "./Arrow.astro";

const steps = [
  {
    title: "Пишете в Telegram",
    text: "Рассказываете про дату свадьбы, песню и идею танца. Цену, место и расписание Дмитрий обсуждает лично.",
  },
  {
    title: "Ловим ритм",
    text: "Первые занятия — база: слышать музыку, вести и следовать, чувствовать друг друга в паре.",
  },
  {
    title: "Собираем танец",
    text: "Хореография под вашу песню и ваш уровень: фигуры, переходы, эффектный финал.",
  },
  {
    title: "Отрабатываем",
    text: "Повторяете танец целиком, пока он не станет привычным. Ближе к свадьбе — с поправкой на платье, обувь и размер площадки.",
  },
  {
    title: "Танцуете",
    text: "Свадьба. Все смотрят на вас, а вы точно знаете каждый следующий шаг.",
  },
];
const threadPath =
  "M50 0 C95 60 5 140 50 200 S95 340 50 400 S5 540 50 600 S95 740 50 800 S5 940 50 1000";
---

<section id="how" class="fx-section">
  <div class="fx-orb top-1/3 -right-32 h-96 w-96 bg-sea/15" aria-hidden="true"></div>

  <div class="fx-wrap relative">
    <div class="mx-auto max-w-3xl text-center">
      <p class="fx-kicker" data-reveal>Как это проходит</p>
      <h2 class="mt-5" data-reveal>От сообщения до <span class="fx-grad">первого танца</span></h2>
    </div>

    <div class="relative mt-14 md:mt-20" data-steps>
      <div class="fx-thread" aria-hidden="true">
        <svg viewBox="0 0 100 1000" preserveAspectRatio="none">
          <path d={threadPath} stroke="rgb(45 52 54 / 0.16)" stroke-width="2" stroke-dasharray="2 9"></path>
        </svg>
        <div class="fx-thread-fill" data-thread-fill>
          <svg viewBox="0 0 100 1000" preserveAspectRatio="none">
            <defs>
              <linearGradient id="fx-thread-gradient" x1="0" y1="0" x2="0" y2="1000" gradientUnits="userSpaceOnUse">
                <stop offset="0" stop-color="#ff9500"></stop>
                <stop offset="0.5" stop-color="#ff6b6b"></stop>
                <stop offset="1" stop-color="#0064ff"></stop>
              </linearGradient>
            </defs>
            <path d={threadPath} stroke="url(#fx-thread-gradient)" stroke-width="4"></path>
          </svg>
        </div>
      </div>
      <ol class="fx-steps">
      {
        steps.map((step, index) => {
          const left = index % 2 === 0;
          return (
            <li class="fx-step">
              <span class="fx-step-num lg:col-start-2 lg:row-start-1" data-reveal="zoom" aria-hidden="true">
                {index + 1}
              </span>
              <div
                class:list={["fx-step-card lg:row-start-1", left ? "lg:col-start-1" : "lg:col-start-3"]}
                data-reveal={left ? "left" : "right"}
              >
                <h3>
                  <span class="sr-only">Шаг {index + 1}. </span>
                  {step.title}
                </h3>
                <p class="mt-2 text-ink/80">{step.text}</p>
              </div>
              <span
                class:list={[
                  "fx-step-ghost lg:row-start-1",
                  left ? "lg:col-start-3" : "lg:col-start-1 lg:justify-self-end",
                ]}
                aria-hidden="true"
              >
                <span class="block" data-parallax="14">
                  0{index + 1}
                </span>
              </span>
            </li>
          );
        })
      }
      </ol>
    </div>

    <div class="fx-summary mt-12 md:mt-16" data-reveal>
      <div>
        <h3 class="text-3xl md:text-4xl">Обычно хватает {site.typicalLessons}</h3>
        <p class="mt-3 max-w-2xl font-medium text-ink/85">
          Лучше начать за месяц-два до свадьбы — останется время спокойно отработать танец. Если времени меньше,
          напишите Дмитрию: вместе подберёте вариант попроще.
        </p>
      </div>
      <a href="#planner" class="fx-btn fx-btn-primary justify-self-start" data-magnetic>
        Собрать программу
        <Arrow />
      </a>
    </div>
  </div>
</section>
