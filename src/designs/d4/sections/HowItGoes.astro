---
import { Image } from "astro:assets";
import { photos } from "../../../data/photos";
import { site } from "../../../data/site";

const steps = [
  {
    title: "Первый контакт",
    text: "Вы пишете Дмитрию в Telegram: рассказываете про дату, песню и идею танца. Договариваетесь о первом занятии.",
    color: "#0f5a9f",
    ink: "#ffffff",
  },
  {
    title: "Основа и ритм",
    text: "На первых занятиях — база: слышать музыку, вести и следовать, чувствовать друг друга в паре.",
    color: "#ff8c42",
    ink: "#2d3436",
    photo: photos.danceHall,
  },
  {
    title: "Хореография",
    text: "Дмитрий собирает танец под вашу песню: фигуры, переходы, эффектный финал. Всё — под ваш уровень.",
    color: "#ffd60a",
    ink: "#2d3436",
    photo: photos.dancePink,
  },
  {
    title: "Отработка",
    text: "Повторяете танец целиком, пока он не станет привычным. Ближе к свадьбе — прогон с поправкой на платье, обувь и размер площадки.",
    color: "#4da6ff",
    ink: "#2d3436",
  },
  {
    title: "Ваш день",
    text: "Свадьба. Все смотрят на вас, а вы видите только друг друга — и точно знаете следующий шаг.",
    color: "#0f5a9f",
    ink: "#ffffff",
  },
];
---

<section class="section bg-[#f5f1e8]" data-section data-section-how-it-goes>
  <div class="container-narrow">
    <p class="kicker text-center mb-4">Пять шагов</p>
    <h2 class="text-center mb-14 md:mb-20">Как это работает</h2>

    <div class="steps" data-steps>
      <div class="steps-rail" aria-hidden="true">
        <div class="steps-rail-fill" data-rail-fill></div>
      </div>
      <ol>

      {
        steps.map((step, index) => (
          <li class="step" data-step>
            <span
              class="step-badge"
              style={`background:${step.color};color:${step.ink}`}
              data-step-badge
              aria-hidden="true"
            >
              {index + 1}
            </span>
            <div class:list={["step-card poster", step.photo && "step-card-photo"]} data-step-card>
              <div>
                <h3 class="mb-3">
                  <span class="sr-only">Шаг {index + 1}. </span>
                  {step.title}
                </h3>
                <p>{step.text}</p>
              </div>
              {
                step.photo && (
                  <Image
                    src={step.photo.src}
                    alt={step.photo.alt}
                    widths={[320, 640]}
                    sizes="(max-width: 768px) 80vw, 280px"
                    class="block w-full aspect-[4/3] object-cover rounded-xl border-2 border-[#2d3436]"
                  />
                )
              }
            </div>
          </li>
        ))
      }
      </ol>
    </div>

    <!-- Summary -->
    <div class="summary poster mt-6 md:mt-10" data-animate-in>
      <div>
        <h3 class="mb-3">Обычно хватает {site.typicalLessons}</h3>
        <p>
          Лучше начать за месяц-два до свадьбы — так останется время спокойно отработать танец.
          Если времени меньше, напишите Дмитрию: вместе подберёте вариант попроще.
        </p>
      </div>
      <a href="#planner" class="btn btn-primary shrink-0">Посчитать по дням</a>
    </div>
  </div>
</section>

<style>
  .steps {
    position: relative;
  }

  .steps ol {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .steps-rail {
    position: absolute;
    top: 0.5rem;
    bottom: 2rem;
    left: 1.25rem;
    width: 4px;
    border-radius: 2px;
    background: rgba(45, 52, 54, 0.12);
  }

  .steps-rail-fill {
    width: 100%;
    height: 100%;
    border-radius: 2px;
    background: linear-gradient(#0f5a9f, #ff8c42 50%, #ffd60a);
    transform-origin: top;
  }

  .step {
    position: relative;
    padding: 0 0 2.5rem 4rem;
  }

  .step-badge {
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 2px solid #2d3436;
    border-radius: 9999px;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1;
  }

  .step-card {
    --poster-shadow: #2d3436;
    display: grid;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    box-shadow: 6px 6px 0 var(--poster-shadow);
  }

  .summary {
    --poster-shadow: #ffd60a;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 1.5rem;
  }

  @media (min-width: 768px) {
    .steps-rail {
      left: 1.75rem;
    }

    .step {
      padding: 0 0 3rem 6rem;
    }

    .step-badge {
      width: 3.75rem;
      height: 3.75rem;
      font-size: 1.75rem;
    }

    .step-card {
      padding: 2rem;
    }

    .step-card-photo {
      grid-template-columns: minmax(0, 1fr) minmax(0, 280px);
    }

    .summary {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding: 2rem;
    }
  }
</style>
