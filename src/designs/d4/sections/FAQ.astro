---
const questions = [
  {
    question: "Мы никогда не танцевали. Получится?",
    answer:
      "Да. Дмитрий работает и с парами, которые никогда раньше не танцевали. Хореография подбирается под ваш уровень, а на подготовку обычно хватает 5–7 занятий.",
  },
  {
    question: "А если до свадьбы мало времени?",
    answer:
      "Напишите Дмитрию как можно раньше. Лучше всего начинать за месяц-два, но если времени меньше — можно выбрать танец попроще и успеть его выучить.",
  },
  {
    question: "Сколько это стоит?",
    answer:
      "Цену, место и расписание Дмитрий обсуждает лично в Telegram — напишите ему, и он всё расскажет.",
  },
  {
    question: "Можно танец под нашу песню?",
    answer:
      "Да. Хореография строится вокруг вас: вашей песни, уровня, платья и размера площадки.",
  },
  {
    question: "Только бачата?",
    answer:
      "Бачата — специализация Дмитрия, но он ставит и любой другой свадебный танец: вальс, медленный танец, микс стилей.",
  },
  {
    question: "Где проходят занятия?",
    answer: "Место и расписание подбираются под вас — договоритесь с Дмитрием в Telegram.",
  },
];
---

<section class="section bg-white" data-section>
  <div class="container-narrow">
    <p class="kicker text-center mb-4">Коротко о главном</p>
    <h2 class="text-center mb-12">Частые вопросы</h2>

    <div class="space-y-4 max-w-3xl mx-auto">
      {
        questions.map((item) => (
          <details class="faq-item" data-animate-in>
            <summary>
              <span>{item.question}</span>
              <span class="faq-mark" aria-hidden="true">
                +
              </span>
            </summary>
            <p>{item.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-item {
    border: 2px solid #2d3436;
    border-radius: 1rem;
    background: #fff;
    box-shadow: 5px 5px 0 #0f5a9f;
    transition:
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }

  .faq-item:nth-child(3n + 2) {
    box-shadow: 5px 5px 0 #ff8c42;
  }

  .faq-item:nth-child(3n) {
    box-shadow: 5px 5px 0 #ffd60a;
  }

  .faq-item[open] {
    transform: translate(-2px, -2px);
  }

  .faq-item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem 1.25rem;
    cursor: pointer;
    user-select: none;
    list-style: none;
    font-family: var(--font-display);
    font-size: 1.05rem;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .faq-item summary::-webkit-details-marker {
    display: none;
  }

  .faq-mark {
    flex-shrink: 0;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    background: #ffd60a;
    border: 2px solid #2d3436;
    font-size: 1.25rem;
    line-height: 1;
    transition: transform 0.3s ease;
  }

  .faq-item[open] .faq-mark {
    transform: rotate(45deg);
  }

  .faq-item p {
    padding: 0 1.25rem 1.25rem;
  }

  @media (min-width: 768px) {
    .faq-item summary {
      padding: 1.25rem 1.5rem;
      font-size: 1.2rem;
    }

    .faq-item p {
      padding: 0 1.5rem 1.5rem;
    }
  }
</style>
