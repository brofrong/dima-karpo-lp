---
import { Image } from "astro:assets";
import { photos } from "../../../data/photos";
import { site } from "../../../data/site";
---

<section class="section bg-white" data-section>
  <div class="container-narrow">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Photos -->
      <div class="grid grid-cols-2 gap-4 md:gap-5" data-animate-in="left">
        <div class="poster overflow-hidden col-span-2">
          <Image
            src={photos.portrait.src}
            alt={photos.portrait.alt}
            widths={[320, 640]}
            sizes="(max-width: 1024px) 92vw, 480px"
            class="block w-full aspect-[16/10] object-cover"
          />
        </div>
        <div class="poster overflow-hidden who-photo-orange">
          <Image
            src={photos.partyWide.src}
            alt={photos.partyWide.alt}
            widths={[320, 640]}
            sizes="(max-width: 1024px) 45vw, 230px"
            class="block w-full aspect-[4/3] object-cover"
          />
        </div>
        <div class="poster overflow-hidden who-photo-gold">
          <Image
            src={photos.teamMedals.src}
            alt={photos.teamMedals.alt}
            widths={[320, 640]}
            sizes="(max-width: 1024px) 45vw, 230px"
            class="block w-full aspect-[4/3] object-cover"
          />
        </div>
      </div>

      <!-- Text -->
      <div>
        <p class="kicker mb-4" data-animate-in>Кто ведёт вас по шагам</p>
        <h2 class="mb-8">{site.name}</h2>

        <div class="space-y-5 text-lg" data-animate-in>
          <p>
            Преподаватель бачаты и постановщик свадебных танцев. Вёл группы для начинающих и
            продолжающих, танцует на вечеринках и фестивалях и ставит танцы парам к свадьбе.
          </p>
          <p>
            <strong>Бачата</strong> — его специализация: тёплый, близкий танец, который хорошо
            смотрится на свадьбе. Но Дмитрий поставит и вальс, и медленный танец, и микс стилей —
            под ту песню, которую выберете вы.
          </p>
          <p>
            Хореография строится вокруг вас: вашей песни, уровня, платья и размера площадки. Опыт
            не нужен — Дмитрий работает и с парами, которые никогда не танцевали.
          </p>
        </div>

        <a
          href={site.instagramUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-accent mt-8"
          data-animate-in
        >
          Танцы в Instagram
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .who-photo-orange {
    --poster-shadow: #ff8c42;
    transform: rotate(-1.5deg);
  }

  .who-photo-gold {
    --poster-shadow: #ffd60a;
    transform: rotate(1.5deg);
  }
</style>
