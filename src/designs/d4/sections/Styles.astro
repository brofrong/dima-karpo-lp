---
---

<section
  class="section py-16 md:py-24 bg-gradient-to-br from-[#f5f1e8] via-white to-[#f5f1e8]"
  data-section
>
  <div class="container-narrow">
    <h2 class="text-center text-3xl md:text-4xl font-display font-bold uppercase mb-12">
      Какой танец вам нравится
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
      <!-- Bachata -->
      <div
        class="bg-white/80 backdrop-blur rounded-xl p-6 hover:shadow-lg transition-shadow"
        data-animate-in
      >
        <svg
          viewBox="0 0 100 140"
          class="w-16 h-20 mx-auto mb-4 text-[#0f5a9f]"
          data-style-icon
        >
          <!-- Male figure -->
          <circle cx="40" cy="20" r="8" fill="currentColor" />
          <path
            d="M 40 28 L 40 50 M 40 35 L 30 45 M 40 35 L 50 45 M 40 50 L 35 80 M 40 50 L 45 80"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
          />

          <!-- Female figure (slightly tilted) -->
          <circle cx="60" cy="25" r="8" fill="currentColor" opacity="0.8" />
          <path
            d="M 60 33 L 60 52 M 60 38 L 52 48 M 60 38 L 68 48 M 60 52 L 55 85 M 60 52 L 65 85"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            opacity="0.8"
          />

          <!-- Connection line (close hold) -->
          <path
            d="M 50 40 Q 55 42 60 40"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            opacity="0.6"
          />
        </svg>
        <h3 class="font-display font-bold text-lg uppercase text-center mb-2">
          Бачата
        </h3>
        <p class="text-sm text-[#666] text-center">
          Тёплый, близкий танец — специализация Дмитрия. Идеально для свадьбы.
        </p>
      </div>

      <!-- Waltz -->
      <div
        class="bg-white/80 backdrop-blur rounded-xl p-6 hover:shadow-lg transition-shadow"
        data-animate-in
      >
        <svg
          viewBox="0 0 100 140"
          class="w-16 h-20 mx-auto mb-4 text-[#ff8c42]"
          data-style-icon
        >
          <!-- Male figure in formal pose -->
          <circle cx="35" cy="22" r="8" fill="currentColor" />
          <path
            d="M 35 30 L 35 52 M 35 36 L 25 48 M 35 36 L 45 46 M 35 52 L 32 85 M 35 52 L 38 85"
            stroke="currentColor"
            stroke-width="2.5"
            fill="none"
            stroke-linecap="round"
          />

          <!-- Female figure in flowing motion -->
          <circle cx="65" cy="20" r="8" fill="currentColor" opacity="0.8" />
          <path
            d="M 65 28 Q 65 45 72 55 M 65 34 L 58 50 M 65 34 L 75 48 M 72 55 L 70 85 M 72 55 L 75 85"
            stroke="currentColor"
            stroke-width="2.5"
            fill="none"
            stroke-linecap="round"
            opacity="0.8"
          />

          <!-- Formal frame -->
          <path
            d="M 45 40 L 65 32"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            opacity="0.5"
          />
        </svg>
        <h3 class="font-display font-bold text-lg uppercase text-center mb-2">
          Вальс
        </h3>
        <p class="text-sm text-[#666] text-center">
          Классика, которая всегда к месту. Элегантна и романтична.
        </p>
      </div>

      <!-- Mix -->
      <div
        class="bg-white/80 backdrop-blur rounded-xl p-6 hover:shadow-lg transition-shadow"
        data-animate-in
      >
        <svg
          viewBox="0 0 100 140"
          class="w-16 h-20 mx-auto mb-4 text-[#ffd60a]"
          data-style-icon
        >
          <!-- Dynamic pose - starting tender -->
          <circle cx="40" cy="18" r="8" fill="currentColor" />
          <path
            d="M 40 26 L 40 48 M 40 32 L 30 42 M 40 32 L 50 44 M 40 48 L 35 80 M 40 48 L 45 80"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
          />

          <!-- Energetic pose -->
          <circle cx="60" cy="28" r="8" fill="currentColor" opacity="0.7" />
          <path
            d="M 60 36 L 58 58 M 60 40 L 48 50 M 60 40 L 72 52 M 58 58 L 54 85 M 58 58 L 62 85"
            stroke="currentColor"
            stroke-width="2"
            fill="none"
            stroke-linecap="round"
            opacity="0.7"
          />

          <!-- Energy lines -->
          <path
            d="M 70 55 L 78 50 M 70 60 L 78 58"
            stroke="currentColor"
            stroke-width="1"
            fill="none"
            opacity="0.4"
          />
        </svg>
        <h3 class="font-display font-bold text-lg uppercase text-center mb-2">
          Микс стилей
        </h3>
        <p class="text-sm text-[#666] text-center">
          От нежного начала к зажигательному финалу. Лучшее обоих миров.
        </p>
      </div>

      <!-- Your song -->
      <div
        class="bg-white/80 backdrop-blur rounded-xl p-6 hover:shadow-lg transition-shadow"
        data-animate-in
      >
        <svg
          viewBox="0 0 100 140"
          class="w-16 h-20 mx-auto mb-4 text-[#4da6ff]"
          data-style-icon
        >
          <!-- Musical note style -->
          <path
            d="M 30 40 Q 35 50 40 65 M 50 25 Q 55 35 60 50"
            stroke="currentColor"
            stroke-width="3"
            fill="none"
            stroke-linecap="round"
          />

          <!-- Couple in rhythm -->
          <circle cx="35" cy="22" r="6" fill="currentColor" />
          <path
            d="M 35 28 L 35 50 M 35 33 L 28 42 M 35 33 L 42 42"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"
          />

          <circle cx="65" cy="25" r="6" fill="currentColor" opacity="0.7" />
          <path
            d="M 65 31 L 65 52 M 65 36 L 58 45 M 65 36 L 72 44"
            stroke="currentColor"
            stroke-width="1.5"
            fill="none"
            stroke-linecap="round"
            opacity="0.7"
          />

          <!-- Heart note -->
          <path
            d="M 50 18 L 55 15 L 57 20 L 52 23 Z"
            fill="currentColor"
            opacity="0.5"
          />
        </svg>
        <h3 class="font-display font-bold text-lg uppercase text-center mb-2">
          Ваш трек
        </h3>
        <p class="text-sm text-[#666] text-center">
          Хореография под вашу любимую песню. Ваша история в танце.
        </p>
      </div>
    </div>
  </div>
</section>
