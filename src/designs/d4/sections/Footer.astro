---
import { site, helloLink } from "../../../data/site";
---

<footer class="bg-[#2d3436] text-white px-4 md:px-8 py-12 md:py-16" data-footer>
  <div class="container-narrow">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 mb-12">
      <!-- Brand -->
      <div>
        <p class="font-display text-xl uppercase mb-3">{site.name}</p>
        <p class="text-sm text-white/80">{site.role}</p>
      </div>

      <!-- Navigation -->
      <div>
        <p class="font-display text-sm uppercase text-[#ffd60a] mb-4">На странице</p>
        <ul class="space-y-2 text-sm">
          <li>
            <a href="#planner" class="hover:text-[#ffd60a] transition-colors">
              Посчитать программу
            </a>
          </li>
          <li>
            <a
              href={site.instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-[#ffd60a] transition-colors"
            >
              Instagram {site.instagramHandle}
            </a>
          </li>
          <li>
            <a href="#hero" class="hover:text-[#ffd60a] transition-colors">Вернуться в начало</a>
          </li>
        </ul>
      </div>

      <!-- Contact -->
      <div>
        <p class="font-display text-sm uppercase text-[#ffd60a] mb-4">Контакт</p>
        <a
          href={helloLink}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-[#ffd60a] text-[#2d3436] font-bold px-4 py-2 rounded-lg hover:bg-white transition-colors"
        >
          Telegram {site.telegramHandle}
        </a>
        <p class="text-xs text-white/60 mt-4">Цена, место и расписание — лично в Telegram</p>
      </div>
    </div>

    <div class="border-t border-white/20 pt-8">
      <p class="text-center text-xs text-white/60">
        {site.name} — постановка свадебного танца шаг за шагом
      </p>
    </div>
  </div>
</footer>
