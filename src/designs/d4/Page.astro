---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Hero from "./sections/Hero.astro";
import WhoIs from "./sections/WhoIs.astro";
import Styles from "./sections/Styles.astro";
import HowItGoes from "./sections/HowItGoes.astro";
import Planner from "./sections/Planner.astro";
import FAQ from "./sections/FAQ.astro";
import Footer from "./sections/Footer.astro";
import { site, helloLink } from "../../data/site";
import "./styles.css";

const title = "Свадебный танец шаг за шагом — Дмитрий Карпов";
const description =
  "Постановка свадебного танца: от первого сообщения до первого танца. Бачата, вальс, микс или ваша песня. Обычно 5–7 занятий.";
const marqueeWords = ["Шаг", "Ритм", "Поворот", "Поддержка", "Финал", "Бачата", "Вальс", "Ваша песня"];
---

<BaseLayout
  title={title}
  description={description}
  themeColor="#f5f1e8"
  variant={4}
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Russo+One&family=Raleway:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main>
    <Hero />
    <div class="marquee" aria-hidden="true">
      <div class="marquee-track">
        {[...marqueeWords, ...marqueeWords, ...marqueeWords, ...marqueeWords].map((word) => <span>{word}</span>)}
      </div>
    </div>
    <WhoIs />
    <Styles />
    <HowItGoes />
    <Planner />
    <FAQ />
    <section class="cta-band px-4 md:px-8 py-20 md:py-28 text-center">
      <div class="container-narrow">
        <h2 class="mb-6">Сделайте первый шаг</h2>
        <p class="text-lg md:text-xl mb-10 max-w-2xl mx-auto" data-animate-in>
          Напишите Дмитрию: расскажите про дату свадьбы и песню — и вместе придумаете ваш танец.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center" data-animate-in>
          <a href={helloLink} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
            Написать в Telegram
          </a>
          <a href={site.instagramUrl} target="_blank" rel="noopener noreferrer" class="btn btn-outline">
            Смотреть в Instagram
          </a>
        </div>
      </div>
    </section>
    <Footer />
  </main>

  <script>
    import { initStepChart } from "./canvas-footprints";
    import { mountPlanner } from "./planner-client";
    import { initAnimations } from "./animations";

    const heroCanvas = document.querySelector<HTMLCanvasElement>("canvas[data-hero-canvas]");
    if (heroCanvas) {
      initStepChart(heroCanvas);
    }

    initAnimations();

    for (const root of document.querySelectorAll<HTMLElement>("[data-planner]")) {
      mountPlanner(root);
    }
  </script>
</BaseLayout>

<style>
  .cta-band {
    background: #ffd60a;
    border-top: 2px solid #2d3436;
    background-image: radial-gradient(rgba(45, 52, 54, 0.12) 2px, transparent 2px);
    background-size: 28px 28px;
  }
</style>
