---
import "../styles/gallery.css";
import { designs, withBase } from "../data/designs";
import { site } from "../data/site";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title={`${site.name} — пять вариантов лендинга`}
  description="Пять разных дизайнов одной страницы: свадебный танец и бачата с Дмитрием Карповым. Выберите тот, что нравится."
  themeColor="#0c0a0e"
  bodyClass="bg-ink text-paper font-sans antialiased"
>
  <Fragment slot="head">
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600&family=Unbounded:wght@500;800&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <main class="mx-auto flex min-h-dvh max-w-6xl flex-col px-5 py-12 sm:px-8 sm:py-20">
    <header class="gallery-rise max-w-3xl">
      <p class="text-sm font-semibold tracking-[0.2em] text-rose uppercase">
        {site.name} · свадебный танец
      </p>
      <h1 class="mt-4 font-display text-4xl leading-[1.05] font-extrabold text-balance sm:text-6xl">
        Пять лендингов. Выберите свой.
      </h1>
      <p class="mt-5 max-w-xl text-lg text-paper/70">
        Одно содержание — пять характеров. В каждом есть календарь: выбираете дату свадьбы и получаете
        программу занятий по дням.
      </p>
    </header>

    <ul class="mt-12 grid gap-4 sm:mt-16 sm:grid-cols-2 lg:grid-cols-6">
      {
        designs.map((design, index) => (
          <li
            class:list={["gallery-rise", index < 2 ? "lg:col-span-3" : "lg:col-span-2"]}
            style={`--i:${index + 1}`}
          >
            <a
              href={withBase(`/${design.number}/`)}
              class="group relative flex h-full min-h-56 flex-col justify-end overflow-hidden rounded-3xl p-6 ring-1 ring-white/10 transition duration-300 hover:-translate-y-1 hover:ring-white/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-paper"
              style={`background:linear-gradient(135deg, ${design.palette.join(", ")})`}
            >
              <span
                class="absolute inset-0 bg-linear-to-t from-black/75 via-black/25 to-transparent"
                aria-hidden="true"
              />
              <span
                class="absolute top-4 right-5 font-display text-7xl leading-none font-extrabold text-white/25 transition duration-300 group-hover:text-white/60"
                aria-hidden="true"
              >
                {design.number}
              </span>
              <span class="relative font-display text-2xl leading-tight font-extrabold text-white">
                {design.name}
              </span>
              <span class="relative mt-2 text-sm text-white/80">{design.tagline}</span>
              <span class="relative mt-4 inline-flex items-center gap-2 text-sm font-semibold text-white">
                Открыть
                <span class="transition duration-300 group-hover:translate-x-1" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>

    <footer class="mt-auto flex flex-wrap gap-x-6 gap-y-2 pt-12 text-sm text-paper/60">
      <a class="underline-offset-4 hover:text-paper hover:underline" href={site.telegramUrl} target="_blank" rel="noopener noreferrer">
        Telegram {site.telegramHandle}
      </a>
      <a class="underline-offset-4 hover:text-paper hover:underline" href={site.instagramUrl} target="_blank" rel="noopener noreferrer">
        Instagram {site.instagramHandle}
      </a>
    </footer>
  </main>
</BaseLayout>
